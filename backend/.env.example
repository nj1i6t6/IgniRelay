# Database
DATABASE_URL=postgresql://resqmesh:resqmesh_secret@localhost:5432/resqmesh

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_to_random_64_char_hex

# Twilio SMS OTP
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+886xxxxxxxx

# OTP settings
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# FIDO2 / WebAuthn (reserved for future government integration)
FIDO2_RELYING_PARTY_ID=resqmesh.network
FIDO2_RELYING_PARTY_NAME=ResQMesh Identity Authority
FIDO2_ORIGIN=https://resqmesh.network

# Rate limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100

# Commander dashboard admin credentials
ADMIN_USERNAME=commander
ADMIN_PASSWORD_HASH=change_me_to_bcrypt_hash

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
